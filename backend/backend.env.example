# ---- Database (MySQL) ----
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DB=translate_app
MYSQL_USER=root
MYSQL_PASSWORD=root

# ---- Redis ----
REDIS_HOST=localhost
REDIS_PORT=6379

# ---- Mail ----
MAIL_USERNAME=your_gmail@gmail.com
MAIL_APP_PASSWORD=your_gmail_app_password

# ---- JWT ----
JWT_SECRET=your_jwt_secret_key_at_least_32_chars

# ---- Google OAuth2 ----
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ---- AI Configuration ----
# Ollama (local LLM — alternatives only)
OLLAMA_API_URL=http://localhost:11434/api/generate
OLLAMA_MODEL=qwen2.5:3b

# Gemini (cloud LLM — judge + compose)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# DeepSeek (bulk sentence translation - platform.deepseek.com, pay-per-token)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# ---- Cloudinary ----
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ---- CORS ----
APP_FRONTEND_DOMAIN=http://localhost:5173
APP_BACKEND_DOMAIN=http://localhost:8080
