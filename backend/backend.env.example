# ---- Database (MySQL) ----
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DB=translate_app
MYSQL_USER=root
MYSQL_PASSWORD=root

# ---- Redis ----
REDIS_HOST=localhost
REDIS_PORT=6379

# ---- Mail ----
MAIL_APP_PASSWORD=your_gmail_app_password

# ---- JWT ----
JWT_SECRET=your_jwt_secret_key_at_least_32_chars

# ---- Google OAuth2 ----
GOOGLE_CLIENT_ID=your_google_client_id
