# translate_app deploy secrets (TWO versions). Copy to `.env`, fill in, `chmod 600 .env`.
# .env is gitignored (root .gitignore: *.env, except *.env.example). NEVER commit real values.
# setup.sh generates a ready-to-use .env automatically if one doesn't exist.

# ---- Cloudflare Tunnel (one tunnel routes BOTH hostnames) ----
# Zero Trust → Networks → Tunnels → create a tunnel → copy its token. Then add two Public
# Hostnames:  <main domain> → http://frontend-main:80  and  <test domain> → http://frontend-test:80
TUNNEL_TOKEN=

# ---- Public URLs (no trailing slash) ----
PUBLIC_URL_MAIN=https://translate.thientnse.site
PUBLIC_URL_TEST=https://translate-test.thientnse.site

# ---- Path to the `main` branch git worktree, relative to this deploy/ folder ----
# Created + kept in sync by setup.sh. Change only if you move the worktree.
MAIN_TREE=../../translate_app_main

# ---- Database (one shared MySQL; each version uses its own database) ----
MYSQL_USER=root
MYSQL_PASSWORD=change-me-strong-db-password
MYSQL_DB_MAIN=translate_app
MYSQL_DB_TEST=translate_app_test

# ---- JWT ----
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
# Stable RSA keypair (base64 DER). If blank, keys regenerate every boot → users logged out on
# each restart. Generate once (see README). setup.sh fills these automatically.
JWT_RSA_PUBLIC_KEY_BASE64=
JWT_RSA_PRIVATE_KEY_BASE64=

# ---- Google OAuth2 (register BOTH redirect URIs in Google Console) ----
#   https://translate.thientnse.site/login/oauth2/code/google
#   https://translate-test.thientnse.site/login/oauth2/code/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Mail (Gmail SMTP app password) ----
MAIL_USERNAME=your_gmail@gmail.com
MAIL_APP_PASSWORD=

# ---- Cloudinary ----
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- AI / translation (optional) ----
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
DEEPL_API_KEY=
DEEPL_API_URL=https://api-free.deepl.com/
OLLAMA_API_URL=
OLLAMA_MODEL=qwen2.5:3b
